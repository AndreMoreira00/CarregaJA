' =====================================================================
' CARREGAJA - Modelo de Caso de Uso (diagramas por ator)
' Projeto: Sistema de Controle e Rateio de Recarga de Veículos
'          Elétricos em Condomínio
' Versão do modelo: 3.0
' Derivado de: 1.Requisitos/CARREGAJA - Visão.md (v3.0)
'
' v3.0: dois diagramas. O diagrama do ator Tempo foi removido junto
'       com o ator, que existia apenas para expirar reservas.
' =====================================================================


' =====================================================================
' 1. MORADOR
' =====================================================================
@startuml CARREGAJA-CasoDeUso-Morador

title CARREGAJA — Casos de Uso do Morador

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #264653
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F7F9F9
  BorderColor #264653
}
skinparam rectangle {
  BorderColor #264653
}

actor "Morador" as MOR

rectangle "CARREGAJA" {
  usecase "UC01\nAutenticar Usuário" as UC01
  usecase "UC02\nConsultar Painel de Vagas" as UC02
  usecase "UC03\nIniciar Sessão de Recarga" as UC03
  usecase "UC04\nCalcular Previsão\nde Conclusão" as UC04 #2A9D8F
  usecase "UC05\nEncerrar Sessão de Recarga" as UC05
  usecase "UC06\nApurar Energia da Sessão" as UC06 #2A9D8F
  usecase "UC07\nManter Veículo" as UC07
  usecase "UC08\nConsultar Consumo do Mês" as UC08
}

MOR -- UC01
MOR -- UC02
MOR -- UC03
MOR -- UC05
MOR -- UC07
MOR -- UC08

UC03 ..> UC04 : <<include>>
UC05 ..> UC06 : <<include>>

note bottom of UC03
  O ciclo do morador se resolve em uma
  única ida à garagem: consulta o painel
  do apartamento (UC02), desce e inicia
  (UC03) e, ao retirar o veículo,
  encerra (UC05).
  Não há reserva prévia — o uso é por
  ordem de chegada (RE-12).
end note

@enduml


' =====================================================================
' 2. SÍNDICO
' =====================================================================
@startuml CARREGAJA-CasoDeUso-Sindico

title CARREGAJA — Casos de Uso do Síndico

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #264653
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F7F9F9
  BorderColor #264653
}
skinparam rectangle {
  BorderColor #264653
}

actor "Síndico" as SIN

rectangle "CARREGAJA" {
  usecase "UC01\nAutenticar Usuário" as UC01
  usecase "UC02\nConsultar Painel de Vagas" as UC02
  usecase "UC06\nApurar Energia da Sessão" as UC06 #2A9D8F
  usecase "UC09\nManter Vagas\ncom Carregador" as UC09
  usecase "UC10\nDefinir Tarifa de Energia" as UC10
  usecase "UC11\nManter Moradores" as UC11
  usecase "UC12\nEncerrar Sessão Órfã" as UC12
  usecase "UC13\nFechar Mês e Gerar Rateio" as UC13
  usecase "UC14\nConsultar Histórico\nde Utilização" as UC14
}

SIN -- UC01
SIN -- UC02
SIN -- UC09
SIN -- UC10
SIN -- UC11
SIN -- UC12
SIN -- UC13
SIN -- UC14

UC12 ..> UC06 : <<include>>
UC13 ..> UC06 : <<include>>

note bottom of UC13
  A carga de uso do síndico é concentrada:
  a configuração (UC09 a UC11) ocorre na
  implantação, o fechamento (UC13) é mensal
  e o tratamento de exceções (UC12) é
  eventual.
end note

@enduml
