@startuml CARREGAJA-ModeloCasoDeUso-Geral
' =====================================================================
' CARREGAJA - Modelo de Caso de Uso (visão geral)
' Projeto: Sistema de Controle e Rateio de Recarga de Veículos
'          Elétricos em Condomínio
' Versão do modelo: 3.0
' Derivado de: 1.Requisitos/CARREGAJA - Visão.md (v3.0)
'
' v3.0: removidos o agendamento (UC03 da v2.0), a expiração de reserva
'       (UC10 da v2.0) e o ator Tempo. Casos de uso renumerados para
'       UC01-UC14, sem lacunas.
' =====================================================================

title CARREGAJA — Modelo de Caso de Uso

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam ArrowColor #264653
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #F7F9F9
  BorderColor #264653
}
skinparam rectangle {
  BorderColor #264653
}

actor "Morador" as MOR
actor "Síndico" as SIN

rectangle "CARREGAJA" {

  ' ---------- Acesso ----------
  usecase "UC01\nAutenticar Usuário" as UC01

  ' ---------- Uso pelo morador ----------
  usecase "UC02\nConsultar Painel de Vagas" as UC02
  usecase "UC03\nIniciar Sessão de Recarga" as UC03
  usecase "UC04\nCalcular Previsão\nde Conclusão" as UC04 #2A9D8F
  usecase "UC05\nEncerrar Sessão de Recarga" as UC05
  usecase "UC06\nApurar Energia da Sessão" as UC06 #2A9D8F
  usecase "UC07\nManter Veículo" as UC07
  usecase "UC08\nConsultar Consumo do Mês" as UC08

  ' ---------- Gestão do condomínio ----------
  usecase "UC09\nManter Vagas\ncom Carregador" as UC09
  usecase "UC10\nDefinir Tarifa de Energia" as UC10
  usecase "UC11\nManter Moradores" as UC11
  usecase "UC12\nEncerrar Sessão Órfã" as UC12
  usecase "UC13\nFechar Mês e Gerar Rateio" as UC13
  usecase "UC14\nConsultar Histórico\nde Utilização" as UC14
}

' ---------- Associações do Morador ----------
MOR -- UC01
MOR -- UC02
MOR -- UC03
MOR -- UC05
MOR -- UC07
MOR -- UC08

' ---------- Associações do Síndico ----------
SIN -- UC01
SIN -- UC02
SIN -- UC09
SIN -- UC10
SIN -- UC11
SIN -- UC12
SIN -- UC13
SIN -- UC14

' ---------- Relacionamentos entre casos de uso ----------
UC03 ..> UC04 : <<include>>
UC05 ..> UC06 : <<include>>
UC12 ..> UC06 : <<include>>
UC13 ..> UC06 : <<include>>

note bottom of UC04
  Os casos de uso UC04 e UC06 concentram
  a regra de negócio do sistema.
  Devem ser atacados primeiro na fase de
  Elaboração, como arquitetura executável
  (risco RI-08 do documento Visão).
end note

note bottom of UC02
  Sem agendamento (RE-12), é a previsão
  de liberação exibida aqui que permite
  ao morador decidir quando descer.
end note

@enduml
